# Copy this file to .env and fill in real values. NEVER commit .env.

NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (use a dedicated database user with readWrite on ONE database)
MONGODB_URI=mongodb+srv://devsurvey:TQPDtmuq3DsKVHgy@cluster0.fmgwpdm.mongodb.net/

# Comma-separated list of frontend origins allowed to call this API directly (CORS)
CORS_ORIGINS=http://localhost:3000

# Admin login (single administrator)
ADMIN_USERNAME=admin
# Generate with: npm run hash-password -- "your-strong-password"
ADMIN_PASSWORD_HASH=
# Long random string (at least 32 characters), e.g. `openssl rand -base64 48`
JWT_SECRET=$2b$12$apsRcdZgBdYM/sj.TIbML.Jqy34PJlY8R0eYIXH4ArV2OuccfQ6ii
JWT_EXPIRES_IN=8h

# Cookie settings: lax (default, same-site via the Next.js proxy), strict, or none (cross-site; requires HTTPS)
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of the API (Render/Railway/Fly = 1). Needed so rate limiting sees real client IPs.
TRUST_PROXY=0

# Rate limits
SUBMIT_RATE_LIMIT_MAX=20
SUBMIT_RATE_LIMIT_WINDOW_MIN=15
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MIN=15

